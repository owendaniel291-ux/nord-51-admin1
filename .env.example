# Paiement Stripe uniquement — commence avec les clés de test Stripe, puis utilise les clés live après validation du compte.
STRIPE_SECRET_KEY=sk_test_remplacer_par_ta_cle_secrete
STRIPE_WEBHOOK_SECRET=whsec_remplacer_par_le_secret_du_webhook
APP_URL=https://ton-domaine.fr

# E-mails transactionnels et campagnes (exemple Gmail avec mot de passe d’application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton-adresse@gmail.com
SMTP_PASS=mot_de_passe_application
MAIL_FROM=NORD 51 <ton-adresse@gmail.com>
ADMIN_NOTIFY_EMAIL=ton-adresse@gmail.com

# Connexion Google (OAuth 2.0) — crée les identifiants dans Google Cloud Console
GOOGLE_CLIENT_ID=ton-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton-client-secret
# Dans Google Cloud, URL de redirection autorisée : https://ton-domaine.fr/auth/google/callback
